#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

#define SERVER_FIFO "/tmp/server_fifo"
#define BUFFER_SIZE 256

struct request {
    int client_id;
    char client_fifo[100];
    char message[BUFFER_SIZE];
};

int main(int argc, char *argv[])
{
    int server_fd, client_fd;
    struct request req;
    char response[BUFFER_SIZE];

    if (argc != 2)
    {
        printf("Usage: %s <client_id>\n", argv[0]);
        return 1;
    }

    req.client_id = atoi(argv[1]);

    // Create a unique FIFO for this client
    snprintf(req.client_fifo,
             sizeof(req.client_fifo),
             "/tmp/client_fifo_%d",
             req.client_id);

    mkfifo(req.client_fifo, 0666);

    // Get message
    printf("Enter message: ");
    fgets(req.message, BUFFER_SIZE, stdin);

    req.message[strcspn(req.message, "\n")] = '\0';

    // Open server FIFO
    server_fd = open(SERVER_FIFO, O_WRONLY);

    if (server_fd == -1)
    {
        perror("server FIFO");
        unlink(req.client_fifo);
        return 1;
    }

    // Send request
    write(server_fd, &req, sizeof(req));

    close(server_fd);

    // Wait for server response
    client_fd = open(req.client_fifo, O_RDONLY);

    if (client_fd == -1)
    {
        perror("client FIFO");
        unlink(req.client_fifo);
        return 1;
    
    }

    read(client_fd, response, sizeof(response));

    printf("Server response: %s\n", response);

    close(client_fd);

    // Remove client's FIFO
    unlink(req.client_fifo);

    return 0;
}
